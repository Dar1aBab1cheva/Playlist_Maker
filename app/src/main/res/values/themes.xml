<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Базовая тема приложения. DayNight означает поддержку автоматического ночного режима -->
    <style name="Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Цвета для СВЕТЛОЙ темы -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/gray</item>
        <item name="colorSecondaryVariant">@color/gray</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Цвет статус-бара (полоска сверху с часами) -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <!-- Цвет фона всего приложения по умолчанию -->
        <item name="android:windowBackground">@color/background_light</item>
    </style>
</resources>