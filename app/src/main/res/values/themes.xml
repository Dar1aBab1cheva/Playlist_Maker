<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- ГЛАВНЫЙ ЭКРАН (Светлая тема) -->
        <item name="colorPrimary">@color/yp_blue</item>       <!-- Синий фон -->
        <item name="colorOnPrimary">@color/white</item>       <!-- Белый текст/иконки на главном экране -->

        <!-- ОСТАЛЬНЫЕ ЭКРАНЫ (Поиск, Настройки) -->
        <item name="colorSurface">@color/yp_white</item>      <!-- Белый фон -->
        <item name="colorOnSurface">@color/yp_black</item>    <!-- Чёрный текст -->

        <item name="colorSecondary">@color/yp_text_gray</item>
        <item name="colorSecondaryVariant">@color/yp_text_gray</item>
        <item name="colorOnSecondary">@color/yp_black</item>

        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimary</item>
        <item name="android:windowBackground">?attr/colorPrimary</item>
    </style>
</resources>