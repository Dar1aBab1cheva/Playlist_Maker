<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Тема для НОЧНОГО режима. Наследуется от той же базовой темы -->
    <style name="Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Цвета для ТЕМНОЙ темы -->
        <item name="colorPrimary">@color/background_dark</item>
        <item name="colorPrimaryVariant">@color/background_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/gray</item>
        <item name="colorSecondaryVariant">@color/gray</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Цвет статус-бара для темной темы -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <!-- Цвет фона всего приложения по умолчанию -->
        <item name="android:windowBackground">@color/background_dark</item>
    </style>
</resources>