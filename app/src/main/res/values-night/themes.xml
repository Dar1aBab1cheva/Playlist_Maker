<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PlaylistMaker" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- ГЛАВНЫЙ ЭКРАН (Тёмная тема) -->
        <item name="colorPrimary">@color/yp_black</item>      <!-- Тёмный фон (#1A1B22) -->
        <item name="colorOnPrimary">@color/white</item>       <!-- Белый текст/иконки -->

        <!-- ОСТАЛЬНЫЕ ЭКРАНЫ (Поиск, Настройки) -->
        <item name="colorSurface">@color/yp_black</item>      <!-- Тёмный фон -->
        <item name="colorOnSurface">@color/white</item>       <!-- Белый текст -->

        <item name="colorSecondary">@color/yp_text_gray</item>
        <item name="colorSecondaryVariant">@color/yp_text_gray</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimary</item>
        <item name="android:windowBackground">?attr/colorPrimary</item>
    </style>
</resources>