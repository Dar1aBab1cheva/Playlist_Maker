<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:padding="@dimen/padding_large">

    <!-- Контейнер для трёх кнопок, которые занимают всю высоту -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:weightSum="3">

        <!-- Кнопка "Поиск" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_search"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="@dimen/margin_between_buttons"
            android:text="@string/search"
            android:textSize="@dimen/text_size_button"
            android:textColor="@color/white"
            android:backgroundTint="@color/blue"
            app:icon="@drawable/ic_search"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/padding_default"
            app:iconTint="@color/white"
            app:cornerRadius="16dp" />

        <!-- Кнопка "Медиатека" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_media"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="@dimen/margin_between_buttons"
            android:text="@string/media"
            android:textSize="@dimen/text_size_button"
            android:textColor="@color/white"
            android:backgroundTint="@color/blue"
            app:icon="@drawable/ic_media"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/padding_default"
            app:iconTint="@color/white"
            app:cornerRadius="16dp" />

        <!-- Кнопка "Плейлист" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_playlist"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/playlist"
            android:textSize="@dimen/text_size_button"
            android:textColor="@color/white"
            android:backgroundTint="@color/blue"
            app:icon="@drawable/ic_playlist"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/padding_default"
            app:iconTint="@color/white"
            app:cornerRadius="16dp" />

    </LinearLayout>

</LinearLayout>