<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/settings_title"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextColor="?attr/colorPrimary" />

    <!-- Переключатель темной темы -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_dark_theme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_medium"
        android:paddingVertical="20dp"
        android:text="@string/setting_dark_theme"
        android:textSize="@dimen/button_text_size"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="?attr/colorOnSurface"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:thumbTint="@color/switch_thumb_tint"
        app:trackTint="@color/switch_track_tint" />

    <!-- Поделиться -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/item_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_medium"
        android:paddingVertical="20dp"
        android:text="@string/setting_share"
        android:textSize="@dimen/button_text_size"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="?attr/colorOnSurface"
        android:drawableEnd="@drawable/ic_share"
        android:drawablePadding="@dimen/margin_medium"
        app:drawableTint="@color/gray"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <!-- Написать в поддержку -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/item_support"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_medium"
        android:paddingVertical="20dp"
        android:text="@string/setting_support"
        android:textSize="@dimen/button_text_size"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="?attr/colorOnSurface"
        android:drawableEnd="@drawable/ic_support"
        android:drawablePadding="@dimen/margin_medium"
        app:drawableTint="@color/gray"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <!-- Пользовательское соглашение -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/item_agreement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_medium"
        android:paddingVertical="20dp"
        android:text="@string/setting_agreement"
        android:textSize="@dimen/button_text_size"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="?attr/colorOnSurface"
        android:drawableEnd="@drawable/ic_arrow_forward"
        android:drawablePadding="@dimen/margin_medium"
        app:drawableTint="@color/gray"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>