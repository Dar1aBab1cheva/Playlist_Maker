<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorOnPrimary"> <!-- Используем атрибут темы для фона -->

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/settings_title"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextColor="?attr/colorPrimary" />

    <!-- Список настроек -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Темная тема -->
        <RelativeLayout
            android:id="@+id/item_dark_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/margin_medium"
            android:paddingHorizontal="@dimen/margin_medium"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                style="@style/SettingsItemTextStyle"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/switch_dark_theme"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="@dimen/margin_medium"
                android:text="@string/setting_dark_theme" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_dark_theme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>

        <!-- Поделиться -->
        <LinearLayout
            android:id="@+id/item_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/margin_medium"
            android:paddingHorizontal="@dimen/margin_medium"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                style="@style/SettingsItemTextStyle"
                android:text="@string/setting_share" />

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:src="@drawable/ic_share"
                android:contentDescription="@null"
                app:tint="@color/gray" />
        </LinearLayout>

        <!-- Поддержка -->
        <LinearLayout
            android:id="@+id/item_support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/margin_medium"
            android:paddingHorizontal="@dimen/margin_medium"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                style="@style/SettingsItemTextStyle"
                android:text="@string/setting_support" />

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:src="@drawable/ic_support"
                android:contentDescription="@null"
                app:tint="@color/gray" />
        </LinearLayout>

        <!-- Соглашение -->
        <LinearLayout
            android:id="@+id/item_agreement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/margin_medium"
            android:paddingHorizontal="@dimen/margin_medium"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                style="@style/SettingsItemTextStyle"
                android:text="@string/setting_agreement" />

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:src="@drawable/ic_arrow_forward"
                android:contentDescription="@null"
                app:tint="@color/gray" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>