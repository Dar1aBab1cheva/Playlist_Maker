<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/track_item_height"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/track_item_horizontal_padding"
    android:paddingVertical="@dimen/track_item_vertical_padding"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/iv_track_artwork"
        android:layout_width="@dimen/track_artwork_size"
        android:layout_height="@dimen/track_artwork_size"
        android:layout_gravity="center_vertical"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_placeholder"
        android:contentDescription="@string/track_artwork" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/track_artwork_to_text_margin"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_track_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/track_title_text_size"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Smells Like Teen Spirit" />

        <TextView
            android:id="@+id/tv_track_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="@color/track_subtitle_color"
            android:textSize="@dimen/track_subtitle_text_size"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Nirvana • 5:01" />
    </LinearLayout>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/track_text_to_chevron_margin"
        android:src="@drawable/ic_arrow_forward"
        app:tint="@color/track_subtitle_color"
        android:contentDescription="@string/chevron_description" />

</LinearLayout>