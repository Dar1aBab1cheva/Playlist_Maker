<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/search_title"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:titleTextColor="?attr/colorOnSurface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_medium">

        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search_hint"
            android:maxLines="1"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:background="@drawable/edit_text_background"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="@color/black"
            android:textColorHint="@color/gray"
            android:textSize="@dimen/button_text_size"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:drawableTint="@color/gray"
            android:textCursorDrawable="@drawable/cursor_color"
            android:paddingStart="12dp"
            android:paddingEnd="48dp" />

        <ImageView
            android:id="@+id/iv_clear_search"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            android:contentDescription="@string/clear_search"
            app:tint="@color/gray" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Индикатор загрузки -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminateTint="?attr/colorOnSurface"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_tracks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <!-- Блок истории поиска -->
        <ScrollView
            android:id="@+id/history_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_history_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/history_vertical_margin"
                    android:text="@string/history_title"
                    android:textAlignment="center"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/history_title_text_size"
                    android:fontFamily="@font/ys_display_medium" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/history_vertical_margin"
                    android:layout_marginBottom="@dimen/history_vertical_margin"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="24dp"
                    android:text="@string/clear_history"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:fontFamily="@font/ys_display_medium"
                    android:backgroundTint="?attr/colorOnSurface"
                    android:textColor="?attr/colorSurface"
                    app:cornerRadius="54dp" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/placeholder_no_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_no_results"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_no_results"
                android:contentDescription="@string/nothing_found" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/nothing_found"
                android:textColor="?attr/colorOnSurface"
                android:textSize="19sp"
                android:fontFamily="@font/ys_display_medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/placeholder_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_server_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_server_error"
                android:contentDescription="@string/server_error" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/server_error"
                android:textAlignment="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="19sp"
                android:fontFamily="@font/ys_display_medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/refresh"
                android:textAllCaps="false"
                android:backgroundTint="?attr/colorOnSurface"
                android:textColor="?attr/colorSurface"
                app:cornerRadius="54dp" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>